#!/usr/bin/env bash

set -euo pipefail

# This script is managed by Chezmoi.
# It will run automatically when you run 'chezmoi apply' or 'chezmoi init'
# but ONLY if any of the tracked package list files or the playbook itself changes.
#
# Only THIS profile's lists are hashed — hashing every profile's lists would make a
# package change on one machine re-trigger a sudo playbook run on all the others.
#
# Tracked package files and playbook:
# playbook.yml hash: {{ include "playbook.yml" | sha256sum }}
{{- if eq (.profile | lower) "omarchy" }}
# Globbed rather than listed by name: the lists live under this machine's own
# directory, and a box that has not generated them yet must still render.
{{- range (glob (joinPath .chezmoi.sourceDir "packages/omarchy" .chezmoi.hostname "*")) }}
# packages/omarchy/{{ $.chezmoi.hostname }}/{{ base . }} hash: {{ include . | sha256sum }}
{{- end }}
{{- else if eq (.profile | lower) "server" }}
# packages/server/pacman.txt hash: {{ include "packages/server/pacman.txt" | sha256sum }}
# packages/server/aur.txt hash: {{ include "packages/server/aur.txt" | sha256sum }}
{{- else if eq (.profile | lower) "mac" }}
# packages/mac/brew.txt hash: {{ include "packages/mac/brew.txt" | sha256sum }}
# packages/mac/casks.txt hash: {{ include "packages/mac/casks.txt" | sha256sum }}
# packages/mac/taps.txt hash: {{ include "packages/mac/taps.txt" | sha256sum }}
{{- end }}

profile="{{ .profile | lower }}"

if [ -z "${profile}" ]; then
    if [ "$(uname)" = "Darwin" ]; then
        echo "⚠️ Warning: No machine profile set! Detected macOS, defaulting to 'mac' profile."
        profile="mac"
    else
        echo "⚠️ Warning: No machine profile set! Defaulting to 'server' profile."
        profile="server"
    fi
fi

echo "📦 Syncing packages ({{ .profile | lower }} profile)…"

if ! command -v ansible-playbook >/dev/null 2>&1; then
    echo "🔧 Installing Ansible..."
    if [ "${profile}" = "mac" ]; then
        if command -v brew >/dev/null 2>&1; then
            brew install ansible
        else
            echo "❌ Error: Homebrew is not installed. Please install Homebrew or install Ansible manually." >&2
            exit 1
        fi
    else
        sudo pacman -S --needed --noconfirm ansible
    fi
fi

# We only use sudo (privilege escalation) for Linux profiles (Omarchy/server)
# because Homebrew on macOS cannot and should not be run as root.
#
# ANSIBLE_CONFIG is passed as a sudo command-line assignment, not exported: sudo
# resets the environment, so an exported value would be dropped and the run would
# silently fall back to Ansible's noisy defaults.
ansible_cfg="{{ joinPath .chezmoi.sourceDir "ansible.cfg" }}"
playbook="{{ joinPath .chezmoi.sourceDir "playbook.yml" }}"
extra_vars="chezmoi_source_dir={{ .chezmoi.sourceDir }} non_root_user={{ .chezmoi.username }} profile=${profile}"

# Ansible's default ~/.ansible/tmp can be unwritable on macOS after a
# migration, restore, or a previous sudo-based install. Use a private,
# per-user directory under the system temporary directory instead.
ansible_local_tmp="${TMPDIR:-/tmp}/ansible-${USER}"
mkdir -p "${ansible_local_tmp}"
chmod 700 "${ansible_local_tmp}"

if [ "${profile}" = "mac" ]; then
    ANSIBLE_CONFIG="${ansible_cfg}" ANSIBLE_LOCAL_TEMP="${ansible_local_tmp}" ansible-playbook \
        -i "localhost," -c local --extra-vars "${extra_vars}" "${playbook}"
else
    sudo ANSIBLE_CONFIG="${ansible_cfg}" ANSIBLE_LOCAL_TEMP="${ansible_local_tmp}" ansible-playbook \
        -i "localhost," -c local --extra-vars "${extra_vars}" "${playbook}"
fi

echo "✅ Packages synced."
