# vim: set filetype=zsh:

# Only auto-attach Herdr in a real interactive terminal. Agent harnesses source
# this file without a TTY, and Herdr's own pane shells must not re-attach.
# The server profile auto-attaches nothing: it is reached via `herdr --remote`,
# which manages its own attach, and a plain ssh should get a plain shell.
{{ if ne (.profile | lower) "server" -}}
if [ -t 0 ] && [ -z "$CLAUDECODE" ] && [ -z "$HERDR_PANE_ID" ] && command -v herdr >/dev/null 2>&1; then
  herdr
fi
{{- end }}

export ZSH="$HOME/.oh-my-zsh"
ZSH_CUSTOM="$HOME/.oh-my-zsh/custom"
zstyle ':omz:update' mode auto

ZCOMPDUMP_DIR="$XDG_CACHE_HOME/zsh"
mkdir -p "$ZCOMPDUMP_DIR"
export ZSH_COMPDUMP="$ZCOMPDUMP_DIR/.zcompdump-${HOST:-local}-${ZSH_VERSION}"
zstyle ':completion:*' menu select

mkdir -p "$HOME/.zsh/completions" "$HOME/.local/share/zsh/site-functions"
fpath=(
  $HOME/.zsh/completions
  $HOME/.local/share/zsh/site-functions
  /usr/local/share/zsh/site-functions
  /usr/share/zsh/site-functions
  /opt/homebrew/share/zsh/site-functions
  $fpath
)

# Some CLIs can generate zsh completions but do not install them. Cache those
# generators before compinit runs, refreshing only when the CLI is updated.
cache_zsh_completion() {
  setopt localoptions pipefail
  local name=$1
  local executable=$2
  shift 2
  [[ -x $executable ]] || return

  local completion="$HOME/.local/share/zsh/site-functions/_$name"
  [[ -s $completion && $completion -nt $executable ]] && return

  local tmp="$completion.$$"
  if "$executable" "$@" 2>/dev/null |
      awk 'seen || /^#compdef / { seen=1; print }' >| "$tmp" && [[ -s $tmp ]]; then
    mv -f -- "$tmp" "$completion"
  else
    rm -f -- "$tmp"
  fi
}

cache_zsh_completion codex "$XDG_DATA_HOME/mise/installs/codex/latest/bin/codex" completion zsh
cache_zsh_completion lazygit "$commands[lazygit]" completion zsh
cache_zsh_completion herdr "$commands[herdr]" completion zsh
unfunction cache_zsh_completion

# --- zsh-autocomplete: debounce so it doesn't complete+redraw on every keystroke
# (must be set BEFORE the plugin is sourced). Fixes lag/flood-crash under
# Herdr/Ghostty without disabling the plugin's history-search / tab behavior.
zstyle ':autocomplete:*' delay 0.15
zstyle ':autocomplete:*' min-input 2
zstyle ':autocomplete:*' list-lines 8    # smaller live list = far less redraw
# Must be a whole number: the zpty worker reads it into a `local -i`.
zstyle ':autocomplete:*' timeout 5

# zsh-autocomplete must initialize before Oh My Zsh runs compinit/compdef.
# Loading it through the plugins array is too late and leaves its helper
# functions absent from the completion dump.
# source "$ZSH_CUSTOM/plugins/zsh-autocomplete/zsh-autocomplete.plugin.zsh"

plugins=(
  git
  github
  archlinux
  tailscale
  sudo
  docker
  docker-compose
  gpg-agent
  gcloud
  uv
  # fzf must load after zsh-autocomplete so fzf's key bindings win
  fzf
  zsh-autosuggestions
  you-should-use
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

# Cap syntax-highlighting work: without this, zsh-syntax-highlighting re-parses
# the whole buffer on every keystroke, so long lines / big pastes flood the
# terminal with redraws and crash the window (zsh-syntax-highlighting #295).
ZSH_HIGHLIGHT_MAXLENGTH=512

setopt AUTO_CD
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt INC_APPEND_HISTORY
setopt GLOB_DOTS
setopt PROMPT_SUBST
setopt EXTENDED_GLOB

source_if_exists() {
  [[ -f "$1" ]] && source "$1"
}

source_if_exists "$HOME/Projects/fc-cli/zsh_completion.sh"

bindkey '^[[A' fzf-history-widget
bindkey '^[OA' fzf-history-widget

# At an interactive prompt, treat Ctrl-C as an editing key and clear only the
# current input. Set the tty mode before ZLE starts so completion widgets save
# and restore that mode; restore SIGINT immediately before commands execute.
_ctrl_c_clear_input() {
  BUFFER=''
  CURSOR=0
  REGION_ACTIVE=0
  zle redisplay
}
zle -N _ctrl_c_clear_input
bindkey -M emacs '^C' _ctrl_c_clear_input
bindkey -M viins '^C' _ctrl_c_clear_input
bindkey -M vicmd '^C' _ctrl_c_clear_input

_ctrl_c_set_interrupt() {
  [[ -t 0 ]] || return 0
  (( ${+commands[stty]} )) || return 0
  command stty intr "$1" </dev/tty 2>/dev/null || true
}
_ctrl_c_before_prompt() {
  _ctrl_c_set_interrupt '^-'
}
_ctrl_c_restore_interrupt() {
  _ctrl_c_set_interrupt '^C'
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _ctrl_c_before_prompt
add-zsh-hook preexec _ctrl_c_restore_interrupt
add-zsh-hook zshexit _ctrl_c_restore_interrupt

# A dropped ssh/mosh never gets to hand the terminal back, so the pane keeps
# whatever the remote turned on (mouse reporting, bracketed paste, alt screen,
# raw tty) and any in-flight query reply lands on the next prompt as raw
# escapes. Undo it whenever a remote-session command returns. Hooks, not an ssh() wrapper: Ghostty's shell
# integration already defines ssh() for ssh-env and must not be shadowed.
autoload -Uz add-zsh-hook
_remote_session_ran=0
_remote_session_tty=''

_remote_session_preexec() {
  local -a words=(${(z)1})
  _remote_session_ran=0
  case $words[1] in
    ssh|autossh|mosh|et) _remote_session_ran=1 ;;
    tailscale) [[ $words[2] == ssh ]] && _remote_session_ran=1 ;;
  esac
  if (( _remote_session_ran )); then
    _remote_session_tty=$(stty -g 2>/dev/null)
  fi
}

_remote_session_precmd() {
  (( _remote_session_ran )) || return
  _remote_session_ran=0
  [[ -t 0 && -t 1 ]] || return
  if [[ -n $_remote_session_tty ]]; then
    stty "$_remote_session_tty" 2>/dev/null || stty sane 2>/dev/null
  else
    stty sane 2>/dev/null
  fi
  printf '\e[?1049l\e[?1000l\e[?1002l\e[?1003l\e[?1005l\e[?1006l\e[?1015l\e[?2004l\e[?1l\e>\e[?7h\e[?25h\e[0m'
  while read -r -s -k 1 -t 0 _ 2>/dev/null; do :; done
}

add-zsh-hook preexec _remote_session_preexec
add-zsh-hook precmd _remote_session_precmd

source_if_exists "$HOME/.aliases"
# iTerm2 only ships this on macOS; the guard makes it a no-op everywhere else.
source_if_exists "$HOME/.iterm2_shell_integration.zsh"
# Machine-local secrets/env (NOT managed by chezmoi — never add it).
source_if_exists "$HOME/.zshrc.local"

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if [[ -o interactive ]]; then
  eval "$(zoxide init --cmd cd zsh)"
  cd() {
    builtin cd "$@" 2>/dev/null || __zoxide_z "$@"
  }
  eval "$(mise activate zsh)"
  eval "$(direnv hook zsh)"
fi
{{ if eq (.profile | lower) "omarchy" -}}
# hyprmon writes monitor config to whatever $HYPRLAND_CONFIG points at (its #1
# priority). Hyprland exports that as hyprland.conf, which is chezmoi-managed —
# so redirect hyprmon to the unmanaged, sourced monitors.conf. Scoped to this
# command only; setting HYPRLAND_CONFIG globally would confuse Hyprland itself.
alias hyprmon='HYPRLAND_CONFIG="$HOME/.config/hypr/monitors.conf" command hyprmon'
{{ end -}}

{{- if eq .profile "omarchy" }}
if [[ -z "$OMARCHY_PATH" ]]; then
  # Omarchy 4 is package-backed at /usr/share/omarchy; 3.x is a git checkout under ~/.local/share.
  if [[ -d /usr/share/omarchy ]]; then
    export OMARCHY_PATH=/usr/share/omarchy
  else
    export OMARCHY_PATH="$HOME/.local/share/omarchy"
  fi
fi
if [[ ":$PATH:" != *":$OMARCHY_PATH/bin:"* ]]; then
  export PATH="$OMARCHY_PATH/bin:$PATH"
fi
source_if_exists "$OMARCHY_PATH/default/bash/envs"

_sync_hypr_signature() {
  if command -v systemctl >/dev/null 2>&1; then
    local _sys_sig
    _sys_sig=$(systemctl --user show-environment 2>/dev/null | awk -F= '$1 == "HYPRLAND_INSTANCE_SIGNATURE" {print $2}')
    if [[ -n "$_sys_sig" && "$HYPRLAND_INSTANCE_SIGNATURE" != "$_sys_sig" ]]; then
      export HYPRLAND_INSTANCE_SIGNATURE="$_sys_sig"
    fi
  fi
}
_sync_hypr_signature

hyprctl() {
  _sync_hypr_signature
  command hyprctl "$@"
}
{{- end }}


# Pull and apply committed dotfiles in the background so machines do not drift behind master.
# Throttled and script-excluded; see ~/.local/bin/chezmoi-autoupdate for why.
if [[ -o interactive ]] && [[ -x "$HOME/.local/bin/chezmoi-autoupdate" ]]; then
  # Local-only apply, synchronous: no network, so an already-pulled change lands on
  # this shell rather than waiting out the throttle.
  "$HOME/.local/bin/chezmoi-autoupdate" --local
  # `sz` exports this so a deliberate reload syncs now instead of waiting out the
  # throttle; unset first or every child process inherits the force flag.
  if [[ -n ${CHEZMOI_AUTOUPDATE_FORCE:-} ]]; then
    unset CHEZMOI_AUTOUPDATE_FORCE
    "$HOME/.local/bin/chezmoi-autoupdate" --force
  else
    "$HOME/.local/bin/chezmoi-autoupdate"
  fi
fi
