#!/bin/sh
# Enable the hourly agent-view prune timer on this machine.
#
# Usage: not run by hand. chezmoi runs it during `apply` whenever its rendered
#        content changes (see the hashes below).
#
# No-ops where no systemd user manager is reachable — a `chezmoi apply` from
# cron/ssh with no session bus. The units themselves are gated to Linux by
# .chezmoiignore, so this script only ships on omarchy/server.
#
# Re-runs when a unit changes:
#   {{ include "dot_config/systemd/user/claude-prune-agents.service.tmpl" | sha256sum }}
#   {{ include "dot_config/systemd/user/claude-prune-agents.timer" | sha256sum }}
set -eu

command -v systemctl >/dev/null 2>&1 || exit 0
if ! systemctl --user show-environment >/dev/null 2>&1; then
	echo "ensure-claude-prune-units: no systemd user manager reachable, skipping"
	exit 0
fi

systemctl --user daemon-reload
systemctl --user enable --now claude-prune-agents.timer
echo "ensure-claude-prune-units: claude-prune-agents.timer enabled"
