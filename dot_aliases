# vim: set filetype=zsh:
alias n="nvim"
alias lg="lazygit"
alias lzd="lazydocker"
alias lzp='lazypodman'
alias cz="chezmoi"
alias czr="chezmoi re-add"
alias czu="chezmoi update"
alias cza="chezmoi apply"
alias py="python3"
alias c="clear"
alias sz="export CHEZMOI_AUTOUPDATE_FORCE=1; exec zsh"
alias nz="ce ~/.zshrc"
alias na="ce ~/.aliases"
alias ne="ce ~/.zshenv"
alias y="yazi"
alias cdz="cd ~/.local/share/chezmoi/"
alias cdpc="cd ~/Projects/cer-backend/"
alias cdpfb="cd ~/Projects/backend/"
alias cs="claude --model sonnet"
alias co="claude --model opus"
alias cw="claude --worktree"
alias dvsc="docker-volume-snapshot create fleetchaser_db_volume $HOME/Projects/tmp/docker/fleetchaser_db_volume"
alias dvsr="docker-volume-snapshot restore $HOME/Projects/tmp/docker/fleetchaser_db_volume fleetchaser_db_volume"

if command -v brew >/dev/null; then
  alias buu="brew update && brew upgrade"
fi

ce() {
  chezmoi edit --apply "$@"
}

cdp() {
  cd ~/Projects/"$1"
}
compdef '_path_files -/ -W ~/Projects' cdp

if command -v eza >/dev/null; then
  alias ls="eza -T -L=1 --group-directories-first --color=always --icons=always"
  alias lsa="eza -a -T -L=1 --group-directories-first --color=always --icons=always"
else
  alias ls="ls --color=auto"
  alias lsa="ls -a --color=auto"
fi
