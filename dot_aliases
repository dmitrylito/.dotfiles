# --- Aliases ---
alias n="nvim"
alias lg="lazygit"
alias lzd="lazydocker"
alias cz="chezmoi"
alias py="python3"
alias c="clear"
alias sz="exec zsh"
alias nz="ce ~/.zshrc"
alias na="ce ~/.aliases"
alias ne="ce ~/.zshenv"
alias y="yazi"
alias dvsc="docker-volume-snapshot create fleetchaser_db_volume /home/dmitrylito/Projects/tmp/docker/fleetchaser_db_volume"
alias dvsr="docker-volume-snapshot restore /home/dmitrylito/Projects/tmp/docker/fleetchaser_db_volume fleetchaser_db_volume"
alias lzp='lazypodman'
alias cdz="cd ~/.local/share/chezmoi"
alias cdp="cd ~/projects/"
alias cdpc="cd ~/projects/cer-backend/"
alias cdpf="cd ~/projects/fleetchaser/"

# Homebrew update & upgrade (buu)
if command -v brew >/dev/null; then
  alias buu="brew update && brew upgrade"
fi

ce() {
  chezmoi edit --apply "$@"
}


# ls aliases (use eza if available)
if command -v eza >/dev/null; then
  alias ls="eza -T -L=1 --group-directories-first --color=always --icons=always"
  alias lsa="eza -a -T -L=1 --group-directories-first --color=always --icons=always"
else
  alias ls="ls --color=auto"
  alias lsa="ls -a --color=auto"
fi
