#!/bin/bash
#
# work-mode — restore the "work" window layout on Hyprland.
#
#   ws 1 : work browser (chromium, "Work" profile) left + FC Gmail right
#   ws 3 : Linear
#   ws 4 : FC Chat (left) + Dialpad (right)
#   ws 5 : FC Tasks
#   scratchpad : Spotify
#
# Idempotent: apps already open are left untouched.
#
# Device-agnostic by construction — nothing machine-specific is hardcoded:
#   * Chromium numbers profile DIRECTORIES in creation order, so "Profile 3" is a
#     different account on another machine. Profiles are looked up by their display
#     name (or account email) in Local State and the directory falls out of that.
#   * The WM_CLASS of an Omarchy web app is derived from the URL plus that resolved
#     directory (chrome-<host>__<path>-<Profile_Dir>), so URL and class cannot drift.
#   * Splits are permille of the workspace's own usable width, not pixel constants,
#     so they hold on any monitor.
# Still device-dependent: which monitor each workspace lives on — that is
# workspaces.lua (nwg-displays output, per-device and chezmoi-ignored).
#
# Hyprland 0.56 parses its config in Lua, which changed how a script drives it:
#   * `hyprctl keyword ...` is refused outright ("keyword can't work with
#     non-legacy parsers"), so the transient class-matched windowrules this
#     script used for placement are gone. `hl.window_rule` can be added at
#     runtime but never removed, so it is no worse than useless here.
#   * `hyprctl dispatch` arguments are now a Lua expression:
#     `hyprctl dispatch 'hl.dsp.window.move({ workspace = "4" })'`.
#   * `hl.dsp.window.resize` takes { x, y, relative?, window? } — OMIT
#     `relative` for an absolute pixel size. There is no `exact` key.
#
# So each window is moved explicitly once it has mapped, and left/right order is
# corrected from real window positions instead of assumed from launch order: a
# moved window is re-inserted at the end of the tiling order, which silently
# swapped the ws-1 pair. Dwindle keeps sizes with slots, not windows, so a swap
# must happen before the resize.

set -uo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

WEBAPP="$HOME/.local/share/omarchy/bin/omarchy-launch-webapp"
CHROMIUM_STATE="${CHROMIUM_USER_DATA_DIR:-$HOME/.config/chromium}/Local State"

WORK_PROFILE='Work'
CHAT_PROFILE='FC Chat'
TASKS_PROFILE='FC Tasks'

BROWSER_LEFT_PERMILLE=725
CHAT_LEFT_PERMILLE=459

# Recover the Hyprland instance signature when launched from a bare .desktop env.
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  sig_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr"
  HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$sig_dir" 2>/dev/null | head -1)"
  export HYPRLAND_INSTANCE_SIGNATURE
fi

log() { printf '[work-mode] %s\n' "$*" >&2; }

dispatch() {
  local out
  out="$(hyprctl dispatch "$1" 2>&1)"
  [[ "$out" == "ok" ]] && return 0
  log "WARN  dispatch rejected: $1 -> $out"
  return 1
}

# profile_dir <display name or account email> -> directory name ("Profile 3")
profile_dir() {
  local dir
  dir="$(jq -r --arg n "$1" \
    'first(.profile.info_cache | to_entries[]
           | select(.value.name == $n or .value.user_name == $n) | .key) // empty' \
    "$CHROMIUM_STATE" 2>/dev/null)"
  [[ -n "$dir" ]] || { log "WARN  no chromium profile named \"$1\""; return 1; }
  printf '%s\n' "$dir"
}

# The class Chromium gives an --app window: host, then "__", then the path with
# "/" -> "_", then the profile directory with spaces -> "_".
webapp_class() {
  local p="${1#*://}"
  p="${p%%#*}"
  p="${p/\//__}"
  printf 'chrome-%s-%s\n' "${p//\//_}" "${2// /_}"
}

# The class only ever holds [A-Za-z0-9._-], so "." is the sole regex metacharacter.
anchored_re() {
  printf '^%s$\n' "${1//./\\.}"
}

addr_of() {
  hyprctl clients -j \
    | jq -r --arg c "$1" 'first(.[] | select(.class | test($c)) | .address) // empty'
}

# geom <address> -> "x width height"
geom() {
  hyprctl clients -j \
    | jq -r --arg a "$1" 'first(.[] | select(.address == $a)
                          | "\(.at[0]) \(.size[0]) \(.size[1])") // empty'
}

# Poll up to 15s for a window matching the class regex to map.
wait_for() {
  local addr="" i
  for ((i = 0; i < 60; i++)); do
    addr="$(addr_of "$1")"
    [[ -n "$addr" ]] && { printf '%s\n' "$addr"; return 0; }
    sleep 0.25
  done
  return 1
}

# launch <label> <class-regex> <workspace> <launch-cmd...>
launch() {
  local label="$1" class_re="$2" ws="$3"; shift 3
  local addr

  addr="$(addr_of "$class_re")"
  if [[ -n "$addr" ]]; then
    log "skip  $label (already open)"
    return 0
  fi

  log "open  $label -> workspace $ws"
  setsid -f "$@" >/dev/null 2>&1

  addr="$(wait_for "$class_re")" || { log "WARN  $label window never appeared"; return 1; }
  dispatch "hl.dsp.window.move({ workspace = \"$ws\", follow = false, window = \"address:$addr\" })"
}

# webapp <label> <workspace> <profile> <url> — prints the class regex it used.
webapp() {
  local label="$1" ws="$2" profile="$3" url="$4" dir re
  dir="$(profile_dir "$profile")" || { log "WARN  skipping $label"; return 1; }
  re="$(anchored_re "$(webapp_class "$url" "$dir")")"
  launch "$label" "$re" "$ws" "$WEBAPP" "$url" --profile-directory="$dir"
  printf '%s\n' "$re"
}

# Put <want> in the left slot of a two-window workspace, if it is not already.
ensure_left() {
  local want="$1" other="$2" wx ox
  wx="$(geom "$want" | cut -d' ' -f1)"
  ox="$(geom "$other" | cut -d' ' -f1)"
  [[ -n "$wx" && -n "$ox" ]] || return 0
  ((wx <= ox)) && return 0

  log "fix   left/right order"
  dispatch "hl.dsp.focus({ window = \"address:$want\" })" || return 1
  dispatch "hl.dsp.window.swap({ direction = \"left\" })" || return 1
  sleep 0.4
}

# Width only — height comes from the window itself, so gap/bar changes can never
# make this a magic number that no longer fits. The pair's own span supplies the
# usable width, so the same permille lands correctly on any monitor.
set_split() {
  local left="$1" right="$2" permille="$3" lx lw lh rx rw rh span gap
  read -r lx lw lh <<<"$(geom "$left")"
  read -r rx rw rh <<<"$(geom "$right")"
  [[ -n "${lh:-}" && -n "${rw:-}" ]] || return 1

  span=$((rx + rw - lx))
  gap=$((rx - lx - lw))
  dispatch "hl.dsp.window.resize({ x = $(((span - gap) * permille / 1000)), y = $lh, window = \"address:$left\" })"
}

BROWSER_CLASS='^chromium$'
SPOTIFY_CLASS='^spotify$'

FOCUS_ADDR="$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')"

if work_dir="$(profile_dir "$WORK_PROFILE")"; then
  launch 'Work browser' "$BROWSER_CLASS" 1 \
    chromium --profile-directory="$work_dir"
fi

GMAIL_CLASS="$(webapp 'FC Gmail' 1 "$WORK_PROFILE" 'https://mail.google.com/mail/u/0/#inbox')"

webapp 'Linear' 3 "$WORK_PROFILE" 'https://linear.app/fleetchaser/agent' >/dev/null

CHAT_CLASS="$(webapp 'FC Chat' 4 "$CHAT_PROFILE" 'https://console.fleetchaser.com/chats')"
DIALPAD_CLASS="$(webapp 'Dialpad' 4 "$WORK_PROFILE" 'https://dialpad.com/app/')"

webapp 'FC Tasks' 5 "$TASKS_PROFILE" 'https://console.fleetchaser.com/tasks' >/dev/null

launch 'Spotify' "$SPOTIFY_CLASS" 'special:spotify' \
  spotify

BROWSER_ADDR="$(addr_of "$BROWSER_CLASS")"
GMAIL_ADDR="${GMAIL_CLASS:+$(addr_of "$GMAIL_CLASS")}"
if [[ -n "$BROWSER_ADDR" && -n "$GMAIL_ADDR" ]]; then
  ensure_left "$BROWSER_ADDR" "$GMAIL_ADDR"
  set_split "$BROWSER_ADDR" "$GMAIL_ADDR" "$BROWSER_LEFT_PERMILLE"
fi

CHAT_ADDR="${CHAT_CLASS:+$(addr_of "$CHAT_CLASS")}"
DIALPAD_ADDR="${DIALPAD_CLASS:+$(addr_of "$DIALPAD_CLASS")}"
if [[ -n "$CHAT_ADDR" && -n "$DIALPAD_ADDR" ]]; then
  ensure_left "$CHAT_ADDR" "$DIALPAD_ADDR"
  set_split "$CHAT_ADDR" "$DIALPAD_ADDR" "$CHAT_LEFT_PERMILLE"
fi

[[ -n "$FOCUS_ADDR" ]] && dispatch "hl.dsp.focus({ window = \"address:$FOCUS_ADDR\" })"

log "done"
