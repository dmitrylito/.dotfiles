#!/usr/bin/env bash
# Fast Django-aware mypy for nvim-lint via the mypy daemon (dmypy).
#
# `dmypy check <file>` follows imports and reports errors across the whole graph,
# so we filter output to just the target file's lines (nvim-lint attaches every
# parsed line to the current buffer). First check warms the daemon (~15s);
# subsequent checks are sub-second.
#
# Called by nvim-lint as: fc-dmypy <file>. Output format (column + error-end)
# comes from ~/.config/fleetchaser-mypy.ini so no CLI flags are needed.

last=""
for last in "$@"; do :; done
start="."
[ -n "$last" ] && [ -e "$last" ] && start=$(dirname "$last")
root=$(git -C "$start" rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$root" || exit 0

# Load docker/envs/* (values contain '&', which `source` mangles) + Bigtable
# fast-fail so the daemon's django.setup() succeeds on the host.
set -a
for f in docker/envs/*.env; do
  [ -e "$f" ] || continue
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue ;; esac
    export "${line%%=*}=${line#*=}"
  done < "$f"
done
export BIGTABLE_EMULATOR_HOST="127.0.0.1:8721"
export BIGTABLE_READ_ENABLED=False
export BIGTABLE_WRITE_ENABLED=False
export FAIL_ON_POSTGRES=False
export DJANGO_SETTINGS_MODULE="fleetchaser.settings"
set +a

CFG="$HOME/.config/fleetchaser-mypy.ini"
DM="$root/.venv/bin/dmypy"

# Start the daemon if it isn't already running (env above is captured at start).
"$DM" status >/dev/null 2>&1 || "$DM" start -- --config-file "$CFG" >/dev/null 2>&1

rel="${last#"$root"/}"
"$DM" check "$rel" 2>/dev/null | grep -F "$rel:"
exit 0
