#!/bin/bash
#
# import-db — refresh the local FleetChaser database from the latest prod dump.
#
# Always downloads the latest production database, imports it (using "Turbo Mode"
# for speed), snapshots the volume, and restarts the stack.
#
# Running this command detaches immediately and continues in the background, so
# it is safe to invoke by hand or from any scheduler (cron, systemd timer, etc.).
# Output is appended to ~/Logs/import_db.log.
#
# Usage:
#   import-db            # start a background refresh, print PID + log path
#   import-db --fg       # run in the foreground (no detach), still logs to file
#

#######################################
# Logging / background configuration
#######################################
LOG_DIR="$HOME/Logs"
LOG_FILE="$LOG_DIR/import_db.log"
mkdir -p "$LOG_DIR"

# Re-exec ourselves detached so the command returns immediately and the import
# keeps running after the invoking shell (or cron job) exits. IMPORT_DB_DETACHED
# guards against re-backgrounding once we are already the detached child.
if [ "${1:-}" = "--fg" ]; then
  shift
elif [ -z "${IMPORT_DB_DETACHED:-}" ]; then
  export IMPORT_DB_DETACHED=1
  setsid "$0" "$@" >>"$LOG_FILE" 2>&1 </dev/null &
  bg_pid=$!
  echo "import-db started in the background (PID $bg_pid)."
  echo "Logs:      $LOG_FILE"
  echo "Follow:    tail -f $LOG_FILE"
  exit 0
fi

#######################################
# Configuration
#######################################
set -Eeuo pipefail # Fail fast on error

# Cron/non-interactive shells often have a minimal PATH.
export PATH="$HOME/google-cloud-sdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

# Simple logging (timestamps + tag)
LOG_PREFIX="[db-refresh]"
log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') ${LOG_PREFIX} $*"
}

# On any error, log where it died
trap 'log "ERROR on line $LINENO (exit code $?): last command: \"$BASH_COMMAND\""' ERR

COMPOSE_DIR=~/Projects/fleetchaser/backend/docker
DOWNLOAD_DIR="$HOME/fleetchaser-db"
GCS_PATH="gs://fleetchaser-production-sql/fleetchaser-prod-latest.gz"
LOCAL_FILE_NAME="fleetchaser-prod-latest.gz"
LOCAL_FILE_PATH="$DOWNLOAD_DIR/$LOCAL_FILE_NAME"
GCS_KEY_PATH="/home/dmitrylito/gcs-key.json"
RESTORE_JOBS="${RESTORE_JOBS:-$(nproc 2>/dev/null || echo 4)}"

DB_SUPERUSER="postgres"
DB_USER="fleetchaser"
DB_PASS="s3cr3t"
DB_NAME="fleetchaser"
RESTORE_EXTRA_ROLES="${RESTORE_EXTRA_ROLES:-fc-readonly}"

log "Script started."
log "COMPOSE_DIR=$COMPOSE_DIR"
log "DOWNLOAD_DIR=$DOWNLOAD_DIR"
log "DB_NAME=$DB_NAME"

#######################################
# Helper Functions
#######################################

refresh_db_container_id() {
  DB_CONTAINER_ID="$(docker compose ps -q db | tail -1 || true)"
  [ -n "${DB_CONTAINER_ID:-}" ]
}

wait_for_db_ready() {
  local context="${1:-startup}"
  local timeout_seconds="${2:-120}"
  local deadline=$((SECONDS + timeout_seconds))

  while :; do
    refresh_db_container_id || true
    if [ -n "${DB_CONTAINER_ID:-}" ] && docker container exec -i "$DB_CONTAINER_ID" psql -U "$DB_SUPERUSER" -d postgres -Atc "SELECT 1" >/dev/null 2>&1; then
      log "SUCCESS: DB is ready ($context). container=$DB_CONTAINER_ID"
      return 0
    fi

    if [ "$SECONDS" -ge "$deadline" ]; then
      log "ERROR: Timed out waiting for DB readiness ($context)."
      return 1
    fi
    sleep 2
  done
}

ensure_restore_roles() {
  log "Ensuring required restore roles exist..."
  local role
  for role in $RESTORE_EXTRA_ROLES; do
    if [ -z "$role" ]; then
      continue
    fi
    docker container exec -i "$DB_CONTAINER_ID" psql -U "$DB_SUPERUSER" -d postgres >/dev/null <<EOF
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '$role') THEN
    EXECUTE format('CREATE ROLE %I', '$role');
  END IF;
END
\$\$;
EOF
  done
  log "Required restore roles are ready."
}

# Drops known-harmless restore noise: Cloud SQL internal-role errors and WAL/checkpoint
# chatter. ERROR/FATAL lines always pass through, even WAL-related ones.
filter_restore_noise() {
  grep -Eiv '^error:  role "cloudsql[a-z]+" does not exist$|^(warning|hint|log|notice):.*(wal|checkpoint)' || true
}

#######################################
# 1. Clean up old backup
#######################################
log "Step 1: Cleaning up any old backup file at $LOCAL_FILE_PATH"
rm -rf "$LOCAL_FILE_PATH"
log "Old backup cleanup complete."

#######################################
# 2. Download Fresh Database
#######################################
log "Step 2: Downloading database from GCS"
mkdir -p "$DOWNLOAD_DIR"

if [ ! -f "$GCS_KEY_PATH" ]; then
  log "ERROR: GCS key file not found at $GCS_KEY_PATH"
  exit 1
fi

log "Downloading database (silencing progress bar to avoid log spam)..."
# Prefer gcloud storage: Cloud-SDK gsutil injects the personal gcloud login
# (which hits Workspace reauth deadlines) and ignores GOOGLE_APPLICATION_CREDENTIALS;
# CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE reliably pins the service-account key.
if [[ "$GCS_PATH" == */ ]]; then
  COPY_RECURSIVE=1
else
  COPY_RECURSIVE=0
fi

if command -v gcloud >/dev/null 2>&1; then
  if [ "$COPY_RECURSIVE" -eq 1 ]; then
    CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE="$GCS_KEY_PATH" gcloud storage cp --recursive --quiet "$GCS_PATH" "$LOCAL_FILE_PATH"
  else
    CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE="$GCS_KEY_PATH" gcloud storage cp --quiet "$GCS_PATH" "$LOCAL_FILE_PATH"
  fi
else
  log "ERROR: 'gcloud' is not installed. Install Google Cloud SDK to continue."
  exit 1
fi

if [ ! -e "$LOCAL_FILE_PATH" ]; then
  log "ERROR: Download failed, backup not found at $LOCAL_FILE_PATH"
  exit 1
fi
log "Download finished. Size: $(du -sh "$LOCAL_FILE_PATH" | cut -f1)"
log "Step 2 complete."

#######################################
# 3. Navigate and Start DB Container
#######################################
log "Step 3: Ensuring database container is running"
cd "$COMPOSE_DIR"

log "Running 'docker compose --progress quiet down'..."
docker compose --progress quiet down

log "Starting ONLY 'db' service..."
docker compose --progress quiet up -d db

log "Waiting for DB to become ready..."
if ! wait_for_db_ready "initial startup" 120; then
  log "ERROR: 'db' container not ready."
  exit 1
fi
log "Found 'db' container: $DB_CONTAINER_ID"

log "Step 3 complete."

#######################################
# 4. Drop and Recreate the Database
#######################################
log "Step 4: Dropping and recreating database '$DB_NAME'"

log "Checking DB existence/dropping..."
docker container exec -i "$DB_CONTAINER_ID" dropdb -U "$DB_SUPERUSER" --if-exists "$DB_NAME" || true

log "Creating new database..."
docker container exec -i "$DB_CONTAINER_ID" createdb -U "$DB_SUPERUSER" -O "$DB_USER" "$DB_NAME"
log "Database '$DB_NAME' created."

ensure_restore_roles

log "Step 4 complete."

#######################################
# 5. Import the Data
#######################################
log "Step 5: Importing data (Standard Output silenced)"
log "Choosing restore strategy (RESTORE_JOBS=$RESTORE_JOBS)..."

IMPORT_START=$(date +%s)
CLEANUP_EXTRA_PATH=""
CONTAINER_RESTORE_PATH=""

if [[ "$RESTORE_JOBS" =~ ^[0-9]+$ ]] && [ "$RESTORE_JOBS" -ge 1 ]; then
  true
else
  log "WARN: Invalid RESTORE_JOBS='$RESTORE_JOBS'. Falling back to 4."
  RESTORE_JOBS=4
fi

if [ -d "$LOCAL_FILE_PATH" ]; then
  log "Detected directory-format backup. Running parallel pg_restore -Fd -j $RESTORE_JOBS..."
  CONTAINER_RESTORE_PATH="/tmp/restore_input_$(date +%s)"
  docker container exec -i "$DB_CONTAINER_ID" rm -rf "$CONTAINER_RESTORE_PATH"
  docker cp "$LOCAL_FILE_PATH" "$DB_CONTAINER_ID:$CONTAINER_RESTORE_PATH"
  PGPASSWORD="$DB_PASS" docker container exec -i "$DB_CONTAINER_ID" pg_restore \
    -U "$DB_USER" -d "$DB_NAME" -Fd -j "$RESTORE_JOBS" "$CONTAINER_RESTORE_PATH" >/dev/null 2> >(filter_restore_noise)
elif [[ "$LOCAL_FILE_PATH" == *.tar.zst ]]; then
  EXTRACT_DIR="${DOWNLOAD_DIR}/restore_dir_$(date +%s)"
  mkdir -p "$EXTRACT_DIR"
  log "Detected .tar.zst backup. Extracting with zstd before parallel restore..."
  tar -I zstd -xf "$LOCAL_FILE_PATH" -C "$EXTRACT_DIR"
  CLEANUP_EXTRA_PATH="$EXTRACT_DIR"
  RESTORE_DIR=$(find "$EXTRACT_DIR" -mindepth 1 -maxdepth 1 -type d | head -1 || true)
  if [ -z "$RESTORE_DIR" ]; then
    log "ERROR: No directory-format dump found after extracting $LOCAL_FILE_PATH"
    exit 1
  fi
  CONTAINER_RESTORE_PATH="/tmp/restore_input_$(date +%s)"
  docker container exec -i "$DB_CONTAINER_ID" rm -rf "$CONTAINER_RESTORE_PATH"
  docker cp "$RESTORE_DIR" "$DB_CONTAINER_ID:$CONTAINER_RESTORE_PATH"
  PGPASSWORD="$DB_PASS" docker container exec -i "$DB_CONTAINER_ID" pg_restore \
    -U "$DB_USER" -d "$DB_NAME" -Fd -j "$RESTORE_JOBS" "$CONTAINER_RESTORE_PATH" >/dev/null 2> >(filter_restore_noise)
elif [[ "$LOCAL_FILE_PATH" == *.dump || "$LOCAL_FILE_PATH" == *.backup || "$LOCAL_FILE_PATH" == *.pgdump || "$LOCAL_FILE_PATH" == *.custom ]]; then
  log "Detected pg_dump archive. Running parallel pg_restore -j $RESTORE_JOBS..."
  CONTAINER_RESTORE_PATH="/tmp/restore_input_$(date +%s)"
  docker container exec -i "$DB_CONTAINER_ID" rm -rf "$CONTAINER_RESTORE_PATH"
  docker cp "$LOCAL_FILE_PATH" "$DB_CONTAINER_ID:$CONTAINER_RESTORE_PATH"
  PGPASSWORD="$DB_PASS" docker container exec -i "$DB_CONTAINER_ID" pg_restore \
    -U "$DB_USER" -d "$DB_NAME" -j "$RESTORE_JOBS" "$CONTAINER_RESTORE_PATH" >/dev/null 2> >(filter_restore_noise)
elif [[ "$LOCAL_FILE_PATH" == *.sql.gz || "$LOCAL_FILE_PATH" == *.gz ]]; then
  INPUT_SIZE_BYTES="$(stat -c%s "$LOCAL_FILE_PATH")"
  if command -v pigz >/dev/null 2>&1; then
    if command -v pv >/dev/null 2>&1; then
      log "Detected gzip SQL. Using pv + pigz -dc -p $RESTORE_JOBS + psql (live ETA in log)."
      PGPASSWORD="$DB_PASS" pv -f -p -t -e -r -b -s "$INPUT_SIZE_BYTES" "$LOCAL_FILE_PATH" |
        pigz -dc -p "$RESTORE_JOBS" |
        docker container exec -i "$DB_CONTAINER_ID" psql "$DB_NAME" -U "$DB_USER" >/dev/null 2> >(filter_restore_noise)
    else
      log "Detected gzip SQL. Using pigz -dc -p $RESTORE_JOBS + psql (install pv for live ETA)."
      PGPASSWORD="$DB_PASS" pigz -dc -p "$RESTORE_JOBS" "$LOCAL_FILE_PATH" |
        docker container exec -i "$DB_CONTAINER_ID" psql "$DB_NAME" -U "$DB_USER" >/dev/null 2> >(filter_restore_noise)
    fi
  else
    if command -v pv >/dev/null 2>&1; then
      log "Detected gzip SQL. Using pv + gunzip + psql (live ETA in log; install pigz for faster decompress)."
      PGPASSWORD="$DB_PASS" pv -f -p -t -e -r -b -s "$INPUT_SIZE_BYTES" "$LOCAL_FILE_PATH" |
        gzip -dc |
        docker container exec -i "$DB_CONTAINER_ID" psql "$DB_NAME" -U "$DB_USER" >/dev/null 2> >(filter_restore_noise)
    else
      log "Detected gzip SQL. Using gunzip + psql (install pigz for speed, pv for live ETA)."
      PGPASSWORD="$DB_PASS" gunzip -c "$LOCAL_FILE_PATH" |
        docker container exec -i "$DB_CONTAINER_ID" psql "$DB_NAME" -U "$DB_USER" >/dev/null 2> >(filter_restore_noise)
    fi
  fi
elif [[ "$LOCAL_FILE_PATH" == *.sql ]]; then
  log "Detected plain SQL file. Restoring through psql..."
  PGPASSWORD="$DB_PASS" docker container exec -i "$DB_CONTAINER_ID" psql "$DB_NAME" -U "$DB_USER" <"$LOCAL_FILE_PATH" >/dev/null 2> >(filter_restore_noise)
else
  log "ERROR: Unrecognized backup format at '$LOCAL_FILE_PATH'. Supported: .sql, .sql.gz, .dump, .backup, .pgdump, directory, .tar.zst"
  exit 1
fi

IMPORT_END=$(date +%s)
IMPORT_DURATION=$((IMPORT_END - IMPORT_START))

log "Database import completed in ${IMPORT_DURATION} seconds (~$((IMPORT_DURATION / 60)) minutes)."

log "Step 5 complete."

#######################################
# 6. Clean up the Downloaded File
#######################################
log "Step 6: Cleaning up downloaded file"
rm -rf "$LOCAL_FILE_PATH"
if [ -n "$CLEANUP_EXTRA_PATH" ]; then
  rm -rf "$CLEANUP_EXTRA_PATH"
fi
if [ -n "$CONTAINER_RESTORE_PATH" ]; then
  docker container exec -i "$DB_CONTAINER_ID" rm -rf "$CONTAINER_RESTORE_PATH"
fi
log "File removed."

#######################################
# 7. Restart the Backend / Full Stack
#######################################
log "Step 7: Restarting full stack with post-import DB snapshot..."

cd "$COMPOSE_DIR"

log "Bringing entire stack down before final startup..."
docker compose --progress quiet down

log "Creating/overwriting DB volume snapshot..."
SNAPSHOT_DIR="$HOME/Projects/fleetchaser/tmp/docker"
mkdir -p "$SNAPSHOT_DIR"
docker run --rm -v fleetchaser_db_volume:/source:ro -v "$SNAPSHOT_DIR":/dest busybox \
  tar -cf /dest/fleetchaser_db_volume.tar -C /source .
log "DB volume snapshot complete."

log "Starting full stack..."
docker compose --progress quiet up -d

log "Full stack is now up and running."
log "Script finished."
