#!/home/dmitrylito/.local/share/uv/tools/analytics-mcp/bin/python
# ga-mcp-refresh-adc — rebuild the impersonated-credentials file that the `google-analytics`
# MCP server (analytics-mcp, installed via `uv tool install`) authenticates with, then verify
# it can read Google Analytics.
#
# Usage: ga-mcp-refresh-adc
#
# Run it after every `gcloud auth application-default login`: that rotates the source refresh
# token this file embeds, and until it is rebuilt the MCP server fails with invalid_grant.
#
# Preconditions:
#   - ~/.config/gcloud/application_default_credentials.json is a fresh authorized_user ADC for
#     an account holding roles/iam.serviceAccountTokenCreator on TARGET_SA (dmitry@bulkbidapp.com).
#   - TARGET_SA has Viewer on the GA4 property; iamcredentials/analyticsadmin/analyticsdata
#     are enabled in project bulkbid.
#
# Writes ~/.config/gcloud/ga-mcp-impersonated-adc.json (mode 0600), the path referenced by
# GOOGLE_APPLICATION_CREDENTIALS in the MCP server entry in ~/.claude.json.

import json
import os
import sys

TARGET_SA = "ga-mcp-reader@bulkbid.iam.gserviceaccount.com"
SCOPE = "https://www.googleapis.com/auth/analytics.readonly"
SRC = os.path.expanduser("~/.config/gcloud/application_default_credentials.json")
DST = os.path.expanduser("~/.config/gcloud/ga-mcp-impersonated-adc.json")

src = json.load(open(SRC))
if src.get("type") != "authorized_user":
    sys.exit(f"{SRC} is type {src.get('type')!r}; expected authorized_user")

config = {
    "type": "impersonated_service_account",
    "service_account_impersonation_url": (
        "https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/"
        f"{TARGET_SA}:generateAccessToken"
    ),
    "source_credentials": {
        "type": "authorized_user",
        "client_id": src["client_id"],
        "client_secret": src["client_secret"],
        "refresh_token": src["refresh_token"],
    },
    "delegates": [],
}

fd = os.open(DST, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump(config, f, indent=2)
print(f"wrote {DST} (mode 600)")

# The shell exports GOOGLE_APPLICATION_CREDENTIALS pointing at the DEFAULT ADC, so
# google.auth.default() would silently test the wrong credentials without this override.
os.environ["GOOGLE_APPLICATION_CREDENTIALS"] = DST

import google.auth
import google.auth.transport.requests
import requests
from google.analytics import admin_v1beta

creds, _ = google.auth.default(scopes=[SCOPE])
if type(creds).__module__ != "google.auth.impersonated_credentials":
    sys.exit(f"loaded {type(creds).__module__}, expected impersonated credentials")

creds.refresh(google.auth.transport.requests.Request())
info = requests.get(
    "https://oauth2.googleapis.com/tokeninfo",
    params={"access_token": creds.token},
    timeout=30,
).json()
print(f"impersonated token scopes: {info.get('scope')}")

client = admin_v1beta.AnalyticsAdminServiceClient(credentials=creds)
for account in client.list_account_summaries():
    for prop in account.property_summaries:
        print(f"visible property: {prop.property} {prop.display_name}")
print("OK: impersonation and GA access work")
