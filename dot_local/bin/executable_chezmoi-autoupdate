#!/usr/bin/env bash
# chezmoi-autoupdate — keep this machine's dotfiles current without blocking the shell.
#
# Usage:
#   chezmoi-autoupdate           throttled; no-op if it already ran within MAX_AGE
#   chezmoi-autoupdate --local   synchronous local-only apply; no network
#   chezmoi-autoupdate --force   ignore the throttle
#   chezmoi-autoupdate --status  print the last run's outcome and exit
#
# Invoked from ~/.zshrc on interactive shell start, twice: once as --local
# (synchronous, ~20ms, applies whatever a previous run pulled) and once throttled
# (detached, does the network). The split is deliberate — a bare `git pull` costs
# ~700ms of round trip even with nothing to fetch, and hangs unbounded when the
# network is down, so nothing touching the network may sit in the shell's path.
#
# Deliberately runs `apply --exclude scripts` rather than `chezmoi update`:
# run_onchange_executable_install-packages.sh shells out to `sudo ansible-playbook`,
# and the pacman package-sync hook rewrites packages/ on every install — so scripts
# re-trigger constantly and must never fire unattended from a shell prompt. Run a
# bare `chezmoi apply` by hand when you actually want the package sync.
#
# Also pushes any local commits the source repo is ahead by — chezmoi's autoPush
# only fires on commits chezmoi itself makes, so commits from editors, agents, or a
# failed pacman-hook push would otherwise sit unpushed indefinitely. The push is
# attempted on every path, including the dirty/pull-failed bails: sending already
# committed work is safe regardless of the working tree's state.
#
# Bails out of the *apply* silently when: the source tree is dirty, the pull is not a
# fast-forward, another run holds the lock, or the machine is offline. Outcome of every
# run is written to $LOG (one line), which is what --status reads.
#
# Serialised against scripts/sync-package-lists.sh via the same lock file, so a
# shell starting mid-pacman-transaction cannot corrupt the source repo's git state.

set -uo pipefail

MAX_AGE=${CHEZMOI_AUTOUPDATE_MAX_AGE:-14400}   # seconds; 4h
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}
STAMP="$CACHE_DIR/chezmoi-autoupdate.stamp"
LOG="$CACHE_DIR/chezmoi-autoupdate.log"
LOCK="${TMPDIR:-/tmp}/chezmoi-git-$(id -u).lock"

log() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >"$LOG"; }

case "${1:-}" in
    --status) [ -r "$LOG" ] && cat "$LOG" || echo "chezmoi-autoupdate: never run"; exit 0 ;;
    --local)  LOCAL=1; FORCE=0 ;;
    --force)  LOCAL=0; FORCE=1 ;;
    "")       LOCAL=0; FORCE=0 ;;
    *)        echo "chezmoi-autoupdate: unknown option: $1" >&2; exit 2 ;;
esac

command -v chezmoi >/dev/null 2>&1 || exit 0
mkdir -p "$CACHE_DIR"

# --local is the synchronous half: apply what an earlier background run already
# pulled. No network, so it costs ~20ms and belongs in the shell's critical path —
# a change fetched an hour ago lands on the next shell instead of waiting out the
# throttle. Safe to rewrite ~/.zshrc while zsh is sourcing it: chezmoi replaces
# targets by atomic rename, so the running shell keeps reading the old inode.
# Non-blocking lock, or a concurrent background apply would stall shell startup on
# chezmoi's persistent-state lock.
if [ "${LOCAL:-0}" -eq 1 ]; then
    apply_local() {
        local src rc
        src=$(chezmoi source-path 2>/dev/null) || return
        git -C "$src" diff --quiet HEAD 2>/dev/null || return
        chezmoi apply --exclude scripts >/dev/null 2>&1
        rc=$?
        [ "$rc" -eq 0 ] || log "failed: local apply returned $rc"
    }
    if command -v flock >/dev/null 2>&1; then
        ( flock -n 9 || exit 0; apply_local ) 9>"$LOCK"
    else
        apply_local
    fi
    exit 0
fi

# -mmin is supported by both GNU and BSD find, unlike `stat` format flags.
if [ "$FORCE" -eq 0 ] && [ -f "$STAMP" ] &&
   [ -z "$(find "$STAMP" -mmin "+$((MAX_AGE / 60))" 2>/dev/null)" ]; then
    exit 0
fi

PUSH_NOTE=""

push_local_commits() {
    local src=$1 ahead
    PUSH_NOTE=""
    git -C "$src" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1 || return
    ahead=$(git -C "$src" rev-list --count '@{u}..HEAD' 2>/dev/null) || return
    [ "${ahead:-0}" -gt 0 ] || return
    if git -C "$src" push --quiet >/dev/null 2>&1; then
        PUSH_NOTE="; pushed $ahead"
    else
        PUSH_NOTE="; push failed ($ahead unpushed)"
    fi
}

run() {
    # Let the shell finish sourcing its rc files before apply can rewrite them.
    sleep 3

    : >"$STAMP"

    local src rc
    src=$(chezmoi source-path 2>/dev/null) || { log "skipped: no source path"; return; }

    if ! git -C "$src" diff --quiet HEAD 2>/dev/null; then
        push_local_commits "$src"
        log "skipped: source has uncommitted changes$PUSH_NOTE"
        return
    fi

    if ! git -C "$src" pull --ff-only --quiet >/dev/null 2>&1; then
        push_local_commits "$src"
        log "skipped: pull failed (offline, or not a fast-forward)$PUSH_NOTE"
        return
    fi

    chezmoi apply --exclude scripts >/dev/null 2>&1
    rc=$?
    push_local_commits "$src"

    if [ "$rc" -eq 0 ]; then
        log "ok: applied $(git -C "$src" rev-parse --short HEAD)$PUSH_NOTE"
    else
        log "failed: chezmoi apply returned $rc$PUSH_NOTE"
    fi
}

# Detach stdio too, or the background child holds the caller's pipe open for its
# whole run — `zsh -ic ... | foo` would block on it.
# flock is Linux-only; on macOS just run unserialised (no pacman hook there to race).
if command -v flock >/dev/null 2>&1; then
    ( flock -n 9 || exit 0; run ) 9>"$LOCK" >/dev/null 2>&1 </dev/null &
else
    ( run ) >/dev/null 2>&1 </dev/null &
fi

disown 2>/dev/null || true
exit 0
