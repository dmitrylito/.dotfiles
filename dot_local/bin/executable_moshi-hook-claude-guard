#!/bin/sh
# moshi-hook-claude-guard — guard wrapper for the Moshi Claude Code hooks.
#
# Usage: called from ~/.claude/settings.json in place of `moshi-hook claude-hook`;
#        every argument is forwarded verbatim. Reads nothing, writes nothing.
#
# Why this exists: moshi-hook takes a session's tmux pane from $TMUX_PANE, and when
# that is unset it GUESSES one by matching the session's cwd against each pane's
# working directory and taking the first match. Tty-less sessions (background jobs,
# scheduled agents) therefore claim a pane they do not occupy — on dlco six panes sit
# in $HOME, so every such session lands on the same wrong one — and Moshi's agent mode
# then binds to a phantom conversation instead of the real Claude. Registering only
# sessions attached to a real terminal avoids the guess altogether.
#
# Verified 2026-07-27 against moshi-hook 0.2.61.

MOSHI_HOOK="${MOSHI_HOOK_BIN:-$HOME/.local/bin/moshi-hook}"

[ -x "$MOSHI_HOOK" ] || exit 0

# Inside tmux the pane is known exactly, so no guess can happen.
[ -n "$TMUX_PANE" ] && exec "$MOSHI_HOOK" "$@"

# /proc/self/stat field 7 is tty_nr, and 0 means no controlling terminal. Fields are
# counted after the last ')' because comm can itself contain spaces and parentheses.
tty_nr=$(sed 's/.*) //' /proc/self/stat 2>/dev/null | cut -d' ' -f5)
[ -n "$tty_nr" ] && [ "$tty_nr" -ne 0 ] 2>/dev/null && exec "$MOSHI_HOOK" "$@"

exit 0
