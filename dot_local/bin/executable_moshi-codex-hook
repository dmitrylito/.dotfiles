#!/bin/bash
# moshi-codex-hook — wrapper for the Moshi Codex hooks.
#
# Usage: called from ~/.codex/hooks.json in place of `moshi-hook codex-hook`; the stdin
#        payload is forwarded verbatim and moshi-hook's stdout and exit code are preserved.
#
# Why the rebind call: `codex app-server` is one long-lived daemon that spawns every hook,
# so every hook inherits the HERDR_PANE_ID of whichever pane happened to start the daemon.
# moshi-hook trusts that env, so every Codex session in every pane is recorded as living in
# that one pane — normally a pane that is long gone — and the Moshi app answers for a pane
# with the wrong conversation. moshi-pane-rebind --codex-only recovers the real pane by
# matching the session's cwd against the herdr panes that are running Codex, and strips a
# claim it cannot resolve. It makes no tmux calls, so it is cheap enough to run per event.

payload=$(cat)
output=$(printf '%s' "$payload" | "$HOME/.local/bin/moshi-hook" codex-hook)
exit_code=$?

if [ "$exit_code" -ne 0 ]; then
  printf '%s' "$output"
  exit "$exit_code"
fi

if [ -n "$output" ]; then
  printf '%s\n' "$output"
else
  printf '{}\n'
fi

timeout 5 "$HOME/.local/bin/moshi-pane-rebind" --codex-only >/dev/null 2>&1 || true
