# Discord forced onto XWayland so its global keybinds (push-to-mute/PTT) work.
# Omarchy exports ELECTRON_OZONE_PLATFORM_HINT=wayland AND OZONE_PLATFORM=wayland
# (/usr/share/omarchy/default/hypr/envs.lua); blanking only the hint is not enough,
# so all Wayland selectors are cleared and x11 is set explicitly.
# Trade-off: screenshare of native-Wayland windows does not work in this mode.
[Desktop Entry]
Name=Discordx
StartupWMClass=discord
Comment=Discord on XWayland (global keybinds work)
GenericName=Internet Messenger
Exec=env -u OZONE_PLATFORM -u WAYLAND_DISPLAY ELECTRON_OZONE_PLATFORM_HINT=x11 XDG_SESSION_TYPE=x11 /usr/bin/discord --ozone-platform=x11
Icon=discord
Type=Application
Categories=Network;InstantMessaging;
Path=/usr/bin
