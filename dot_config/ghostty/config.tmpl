# Ghostty Configuration Template managed by Chezmoi
# Profiles: omarchy (Linux), mac (macOS)
background = 000000
{{ if eq .profile "omarchy" -}}
# --- Omarchy Profile Configuration ---

# Dynamic theme colors from Omarchy
config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"

background = 000000

# Font size
font-size = 11

# Window
gtk-toolbar-style = flat

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

{{- else if eq .profile "mac" -}}
# --- macOS Profile Configuration ---

# Theme (Built-in "Catppuccin Mocha")
theme = "Catppuccin Mocha"


# Font size
font-size = 13

macos-titlebar-style = hidden

# Option key as Alt (essential for standard command-line navigation/shortcuts)
macos-option-as-alt = true

{{- end }}

# --- Global Configuration ---

# Font
font-family = "JetBrainsMono Nerd Font"
font-style = Regular

app-notifications = false

# Window
confirm-close-surface = false
resize-overlay = never
background-opacity-cells = true

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Shell integration
shell-integration-features = no-cursor,ssh-env,no-title

# Keyboard bindings
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Mouse
mouse-scroll-multiplier = 1.5

# Window & Padding
window-padding-x = 20
window-padding-y = 20

background = 000000
