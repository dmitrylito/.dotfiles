{{- $mac := eq (.profile | lower) "mac" -}}
# Voxtype Configuration
#
# Location: ~/.config/voxtype/config.toml
# All settings can be overridden via CLI flags
#
# Shared between the omarchy and mac profiles. The omarchy values are tuned for
# that box's GPU and for Wayland's uinput typing path (dotool); neither applies
# on macOS, which types through the accessibility API and has no XDG_RUNTIME_DIR.
{{ if $mac -}}
# Parakeet is EXPERIMENTAL on macOS and ships no downloaded model, so mac stays
# on whisper. To switch after fetching one: voxtype setup model
engine = "whisper"

# No XDG_RUNTIME_DIR on macOS, so "auto" has nowhere to resolve to. The FN
# hotkey drives recording directly, so no external state consumer needs it.
state_file = "disabled"

[hotkey]
# macOS has no compositor keybinding, so voxtype owns the hotkey itself.
# Cmd+Z mirrors the SUPER+Z dictation binding in hypr/bindings.conf (same
# physical keys). It shadows Undo, which voxtype's CGEvent tap swallows while
# the daemon runs — pick another key here if that bites.
enabled = true
key = "Z"
modifiers = ["cmd"]
mode = "toggle"
{{- else -}}
# State file for external integrations (Waybar, polybar, etc.)
# Use "auto" for default location ($XDG_RUNTIME_DIR/voxtype/state),
# a custom path, or "disabled" to turn off. The daemon writes state
# ("idle", "recording", "transcribing") to this file whenever it changes.
# Required for `voxtype record toggle` and `voxtype status` commands.
engine = "parakeet"

state_file = "auto"

[hotkey]
# Hotkey is configured in Hyprland. Default is Super + Ctrl + X
enabled = false
key = "HOME"
mode = "toggle"
# key = "HOME"
# mode = "toggle"
{{- end }}

[audio]
# Audio input device ("default" uses system default)
# List devices with: pactl list sources short
device = "default"

# Sample rate in Hz (whisper expects 16000)
sample_rate = 16000

# Hard cap: at this many seconds voxtype closes capture mid-sentence and drops the tail.
# Thinking pauses count toward it, so the stock 60 s cut real dictation off ~9x/day; the TUI
# help calls 120-300 s normal. Cost of a high cap under streaming+toggle: a forgotten toggle
# types room noise at the cursor for this long.
max_duration_secs = 300

# Pause MPRIS media players during recording
pause_media = false

[audio.feedback]
enabled = true
theme = "default"
# 0.0-1.0, not percent; `voxtype configure` ignores this field (always shows 70%) -- edit here, not in the TUI.
volume = 0.15

[output]
# Primary output mode: "type" or "clipboard"
mode = "type"

# Fall back to clipboard if typing fails
fallback_to_clipboard = true

# Delay between typed characters in milliseconds
# 0 = fastest possible, increase if characters are dropped
type_delay_ms = 0
auto_submit = false
shift_enter_newlines = false
{{ if $mac }}
# driver_order is deliberately unset: every named driver (wtype, eitype, dotool,
# ydotool, xclip) is a Linux tool, so macOS falls through to its own
# accessibility-API typing path.

# No uinput device to settle on macOS, so nothing to guard against here.
pre_type_delay_ms = 0
{{- else }}
# Compositor integration hooks (modifier key fix)
# pre_recording_command = "hyprctl dispatch submap voxtype_recording"
# pre_output_command = "hyprctl dispatch submap voxtype_suppress"
# post_output_command = "hyprctl dispatch submap reset"

# Preferred driver order: prioritize dotool (via persistent dotoold daemon)
# to avoid Wayland device-churn and focus jitter under streaming mode.
driver_order = ["dotool", "clipboard"]

# No delay before typing starts; the persistent dotoold daemon keeps one uinput
# device alive, so there is no per-output device-settle race to guard against.
pre_type_delay_ms = 0
{{- end }}

[output.notification]
# Show notification when recording starts (hotkey pressed)
on_recording_start = false

# Show notification when recording stops (transcription beginning)
on_recording_stop = false

# Show notification with transcribed text after transcription completes
on_transcription = false
show_engine_icon = false

[text]
spoken_punctuation = false
smart_auto_submit = false

[meeting]
enabled = false

[meeting.diarization]
enabled = false

[meeting.audio]
source = "default"

[vad]
# Enable Voice Activity Detection to filter out empty recordings
enabled = false
backend = "auto"
threshold = 0.5

[status]
icon_theme = {{ if $mac }}"default"{{ else }}"omarchy"{{ end }}

[whisper]
{{- if $mac }}
model = "base.en"
language = "en"
translate = false
mode = "local"
on_demand_loading = false
{{- else }}
gpu_isolation = false
on_demand_loading = false
flash_attention = true
eager_processing = true
model = ""
mode = "local"
language = "auto"
translate = false

[parakeet]
# only streaming-capable Parakeet model (int8 is batch-only)
model = "parakeet-unified-en-0.6b"
# keep model resident for low latency
on_demand_loading = false
streaming = true
# Encoder frame = 80 ms (subsampling_factor = 8) -> keep values as multiples of 0.08.
# Floor latency ~= chunk + right + one forward pass = 0.32 + 1.04 = ~1.4 s.
# CHUNK is the latency-only knob: it's how much new audio is swallowed per inference
# step, NOT the model's context. Every output frame still sees the full left+right
# window regardless of chunk, so shrinking it lowers latency with ZERO accuracy or
# punctuation cost -- it just runs more forward passes, each paid on CPU: MIGraphX offloads only decoder_joint, never the encoder.
# RIGHT context is pure lookahead: raising it adds that much wait before a word can be
# emitted, 1:1. It buys accuracy + punctuation and costs latency -- never both. 1.04 s =
# 13 frames, called the practical ceiling for this model (unverified; audio_signal has
# dynamic axes, so higher likely runs, just slower with diminishing accuracy return).
# LEFT context costs compute per pass, NOT waiting: encoder.onnx takes only audio_signal +
# length and exposes no cache tensors, so each pass re-encodes the whole left+chunk+right
# window from scratch. Redundant work scales as window/chunk (~17x here) -- if the GPU ever
# falls behind, raise chunk first, since that divides the pass count.
streaming_chunk_secs = 0.32
streaming_left_context_secs = 4.0
streaming_right_context_secs = 1.04

[osd]
# gtk4 frontend is Linux-only; macOS draws its overlay with AppKit instead.
enabled = false
frontend = "gtk4"
position = "bottom-center"
width_px = 400
height_px = 48
margin_px = 24
top_margin = 0.85
opacity = 0.95
waveform_window_secs = 3.0
peak_decay_db_per_sec = 6.0
waveform_gain = 10.0
{{- end }}
