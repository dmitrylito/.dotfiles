# Prefix
set -g prefix C-Space
set -g prefix2 C-b
bind C-Space send-prefix

# Search ergonomics
bind-key -T copy-mode-vi / command-prompt -i -p "search down" "send -X search-forward-incremental \"%%%\""
bind-key -T copy-mode-vi ? command-prompt -i -p "search up" "send -X search-backward-incremental \"%%%\""

# Set default terminal inside tmux
set -g default-terminal "tmux-256color"

# Tell Tmux that Ghostty supports Truecolor (Tc)
set -ag terminal-overrides ",xterm-ghostty:Tc"
set -ag terminal-overrides ",xterm-256color:Tc"

# Eliminate escape delay (critical for TUI apps)
set -sg escape-time 0
set -g focus-events on

# Optional later: synchronize panes
# bind S setw synchronize-panes

# Reload config
bind q source-file ~/.config/tmux/tmux.conf \; display "Reloaded!"

bind g display-popup -d "#{pane_current_path}" -E -w 90% -h 90% "lazygit"

# Vi mode for copy
setw -g mode-keys vi
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-selection-and-cancel
bind -T copy-mode-vi C-v send -X rectangle-toggle

# Pane controls
bind h split-window -v -c "#{pane_current_path}"
bind v split-window -h -c "#{pane_current_path}"
bind x kill-pane
bind p display-panes

bind -n C-M-Left select-pane -L
bind -n C-M-Right select-pane -R
bind -n C-M-Up select-pane -U
bind -n C-M-Down select-pane -D

bind -n C-M-S-Left resize-pane -L 5
bind -n C-M-S-Down resize-pane -D 5
bind -n C-M-S-Up resize-pane -U 5
bind -n C-M-S-Right resize-pane -R 5

# Window navigation
bind r command-prompt -I "#W" "rename-window -- '%%'"
bind c new-window -c "#{pane_current_path}"
bind k kill-window
bind T run-shell "~/.tmuxifier/bin/tmuxifier load-window Dev"

bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5
bind -n M-6 select-window -t 6
bind -n M-7 select-window -t 7
bind -n M-8 select-window -t 8
bind -n M-9 select-window -t 9

# Move current window to 0-9 and shift others
bind -n M-! swap-window -d -t 1
bind -n M-@ swap-window -d -t 2
bind -n M-\# swap-window -d -t 3
bind -n M-\$ swap-window -d -t 4
bind -n M-% swap-window -d -t 5
bind -n M-^ swap-window -d -t 6
bind -n M-& swap-window -d -t 7
bind -n M-* swap-window -d -t 8
bind -n M-( swap-window -d -t 9
bind -n M-) swap-window -d -t 0

# Session controls
bind R command-prompt -I "#S" "rename-session -- '%%'"
bind C new-session -c "#{pane_current_path}"
bind K kill-session
bind P switch-client -p
bind N switch-client -n

# Sesh launcher
bind-key -n M-a display-popup -E -w 80% -h 70% "~/.config/tmux/sesh_launcher.sh"

# General
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g history-limit 50000
set -g escape-time 0
set -g focus-events on
set -g set-clipboard on
set -g allow-passthrough on
# Ensure tmux forwards OSC 52 to its parent terminal (Ghostty / outer tmux),
# so yanks chain all the way up even through a nested tmux.
set -ag terminal-features ",tmux-256color:clipboard"
set -ag terminal-features ",xterm-ghostty:clipboard"
set -ag update-environment " LANG LC_ALL LC_CTYPE"
setw -g aggressive-resize on
set -g detach-on-destroy off
set -g extended-keys on
set -g extended-keys-format csi-u
set -sg escape-time 10
setw -g automatic-rename off
setw -g allow-rename off

# Status bar
set -g status-position top
set -g status-interval 60
set -g status-justify centre
set -g status-left-length 30
set -g status-right-length 50
set -g window-status-separator ""

# Omarchy theme
set -g status-style "bg=default,fg=default"
set -g status-left "#[fg=black,bg=blue,bold] #S #[bg=default] "
set -g status-right "#[fg=blue]#{?client_prefix,PREFIX ,}#[fg=brightblack]#h "
set -g window-status-format "#[fg=brightblack] #I:#W "
set -g window-status-current-format "#[fg=blue,bold] #I:#W "

set -g pane-border-style "fg=brightblack"
set -g pane-active-border-style "fg=blue"
set -g pane-border-lines heavy
set -g pane-border-indicators colour
set -g pane-border-status top
set -g pane-border-format ""

set -g window-active-style "bg=default"
set -g window-style "bg=default"


set -g message-style "bg=default,fg=blue"
set -g message-command-style "bg=default,fg=blue"
set -g mode-style "bg=blue,fg=black"
setw -g clock-mode-colour blue

# Plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'MunifTanjim/tmux-suspend'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'alexwforsythe/tmux-which-key'

# Plugin settings
# NOTE: disable XDG on macOS only. The plugin's XDG path code uses
# `realpath --relative-to` (GNU coreutils only); macOS BSD realpath fails
# under `set -e`, aborting the plugin so tpm reports "returned 1". Linux
# ships GNU coreutils, so XDG works fine there.
set -g @tmux-which-key-xdg-enable {{ if eq (.profile | lower) "mac" }}0{{ else }}1{{ end }}
set -g @suspend_suspended_options "status::off,pane-border-status::off"
set -g @continuum-restore 'on'
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-processes 'ssh'


# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.config/tmux/plugins/tpm/tpm'
