[Unit]
Description=Seerr
After=network-online.target

[Container]
Image=ghcr.io/seerr-team/seerr:latest
AutoUpdate=registry
Pod=media.pod
Environment=TZ=America/New_York
HealthCmd=wget -q --spider http://127.0.0.1:5055/api/v1/status
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
Volume=/home/dmitrylito/docker-appdata/seerr:/app/config:Z
Volume=/data/media:/data/media:z

[Install]
WantedBy=default.target

[Service]
Restart=always
