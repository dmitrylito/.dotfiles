# Repo tooling — lives in the chezmoi source dir, never deployed to $HOME
README.md
CLAUDE.md
package-lock.json
playbook.yml
ansible.cfg
packages/
scripts/

# WM / editor state that is machine-specific or generated
.config/hypr/shaders/
.config/hypr/monitors.lua
.config/hypr/workspaces.lua
.config/nvim/lazy-lock.json

# tmux plugins are installed and managed by tpm, not chezmoi
.config/tmux/plugins/

# Auto-memory is per-machine runtime state that the memory system rewrites constantly;
# managing it guarantees permanent drift and would sync one box's memories onto another.
.claude/projects/*/memory/

{{ if and (ne (.profile | lower) "omarchy") (ne (.profile | lower) "mac") }}
.config/ghostty/
.config/voxtype/
{{ end }}

{{ if ne (.profile | lower) "omarchy" }}
.config/hypr/
.config/systemd/user/dotoold.service
# herdr is desktop-only; MOSHI_HERDR_PATH must not point at a missing binary elsewhere.
.config/systemd/user/moshi-hook.service.d/20-herdr-path.conf
.config/systemd/user/herdr-server.service
.config/systemd/user/graphical-session.target.wants/
.config/mimeapps.list
.config/spotify-flags.conf
.local/share/applications/
.XCompose
{{ end }}

{{ if ne (.profile | lower) "mac"}}
.config/aerospace/
.config/sketchybar/
.config/borders/
# macOS voxtype ignores XDG_CONFIG_HOME and only reads this path, so mac
# symlinks it at .config/voxtype/ rather than keeping a second copy.
Library/
{{ end }}

{{ if eq (.profile | lower) "mac" }}
# macOS has launchd, not systemd — the whole user-units tree is Linux-only.
.config/systemd/
{{ end }}
