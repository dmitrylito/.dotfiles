{
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "theme": "auto",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "terminalProgressBarEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MSG=$(jq -r '.message // \"Claude needs your attention\"'); notify-send --urgency=critical --app-name='Claude Code' 'Claude Code' \"$MSG\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send --urgency=normal --app-name='Claude Code' 'Claude Code' 'Task complete'"
          }
        ]
      }
    ]
  }
}
