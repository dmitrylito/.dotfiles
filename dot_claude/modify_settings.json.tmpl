        "code-simplifier@claude-plugins-official": True,
        "commit-commands@claude-plugins-official": True,
        "djlsp-plugin@lsp-marketplace": True,
        "frontend-design@claude-plugins-official": True,
        "github@claude-plugins-official": True,
        "huggingface-skills@claude-plugins-official": True,
        "linear@claude-plugins-official": True,
        "pyright-lsp@claude-plugins-official": True,
        "remember@claude-plugins-official": True,
        "security-guidance@claude-plugins-official": True,
        "sentry@claude-plugins-official": True,
        "typescript-plugin@lsp-marketplace": True,
    },
    "env": {"CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"},
    "extraKnownMarketplaces": {
        "lsp-marketplace": {
            "source": {"path": HOME + "/lsp-marketplace", "source": "directory"}
        }
    },
    "hooks": {
        "PermissionRequest": [
            {"hooks": [{"async": False, "command": MOSHI_COMMAND, "type": "command"}]}
        ],
        "PostToolUse": [
            {
                "hooks": [{"async": True, "command": MOSHI_COMMAND, "type": "command"}],
                "matcher": "AskUserQuestion",
            },
            {
                "hooks": [{"async": True, "command": MOSHI_COMMAND, "type": "command"}],
                "matcher": "ExitPlanMode",
            },
        ],
        "PreToolUse": [
            {
                "hooks": [{"async": True, "command": MOSHI_COMMAND, "type": "command"}],
                "matcher": "AskUserQuestion",
            },
            {
                "hooks": [{"async": True, "command": MOSHI_COMMAND, "type": "command"}],
                "matcher": "ExitPlanMode",
            },
        ],
        "SessionEnd": [
            {"hooks": [{"async": True, "command": MOSHI_COMMAND, "type": "command"}]}
        ],
        "SessionStart": [
            {"hooks": [{"async": True, "command": MOSHI_COMMAND, "type": "command"}]}
        ],
        "Stop": [
            {"hooks": [{"async": True, "command": MOSHI_COMMAND, "type": "command"}]}
        ],
        "UserPromptSubmit": [
            {"hooks": [{"async": True, "command": MOSHI_COMMAND, "type": "command"}]}
        ],
    },
    "inputNeededNotifEnabled": True,
    "model": "opus[1m]",
    "permissions": {
