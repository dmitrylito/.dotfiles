autoload -Uz compinit && compinit

# XDG Base Directories
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

PATH=$PATH:$HOME/.local/bin

# Ensure TERM is set for proper line editing and completion
if [[ -z "${TERM:-}" || "$TERM" == "dumb" ]] || ! tput longname >/dev/null 2>&1; then
  export TERM="xterm-256color"
fi

# Tooling configuration
export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship.toml"
export YDOTOOL_SOCKET="$HOME/.ydotool_socket"
export HYPRLAND_CONFIG="$XDG_CONFIG_HOME/hypr/hyprland.conf"
export PATH="/home/dmitrylito/.cache/.bun/bin:$PATH"
export PATH="$HOME/.local/share/bob/nvim-bin:$PATH"
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/cuda/lib64

# Ensure path is unique
typeset -U path

# Path construction
path=(
  $HOME/.tmuxifier/bin
  $HOME/.local/bin
  $HOME/go/bin
  $HOME/.cargo/bin
  $APP_PATH/bin/.local/bin
  $XDG_DATA_HOME/bob/nvim-bin
  /usr/local/bin
  $path

)

# Linuxbrew
if [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# MacOS specific PATH
if [[ "$OSTYPE" == "darwin"* ]]; then
  path=(/Users/dmitrylitoshik/.antigravity/antigravity/bin $path)
fi

# The next line updates PATH for the Google Cloud SDK.
if [[ -f /home/dmitrylito/google-cloud-sdk/path.zsh.inc ]]; then
  . /home/dmitrylito/google-cloud-sdk/path.zsh.inc
fi

# The next line enables shell command completion for gcloud.
if [[ -f /home/dmitrylito/google-cloud-sdk/completion.zsh.inc ]]; then
  . /home/dmitrylito/google-cloud-sdk/completion.zsh.inc
fi

# opencode
export PATH=/home/dmitrylito/.opencode/bin:$PATH

eval "$(zoxide init --cmd cd zsh)"
eval "$(bob complete zsh)"
eval "$(mise activate zsh)"
eval "$(mise completion zsh)"
