{
  "security": {
    "auth": {
      "selectedType": {{ if eq .profile "server" }}"vertex-ai"{{ else }}"oauth-personal"{{ end }}
    },
    "enablePermanentToolApproval": true
  },
  "general": {
    "vimMode": true,
    "defaultApprovalMode": "default"
  },
  "ui": {
    "hideTips": true,
    "errorVerbosity": "low",
    "showLineNumbers": false,
    "useAlternateBuffer": true,
    "footer": {
      "showLabels": false,
      "items": [
        "workspace",
        "git-branch",
        "model-name",
        "quota"
      ]
    },
    "terminalBackgroundPollingInterval": 10,
    "hideWindowTitle": true,
    "hideBanner": true,
    "terminalBuffer": true
  },
  "experimental": {
    "topicUpdateNarration": false,
    "useOSC52Paste": true,
    "useOSC52Copy": true
  },
  "model": {
    "name": "auto-gemini-3"
  }
}