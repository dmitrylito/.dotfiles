#!/bin/sh
# Register the chezmoi-managed Moshi systemd user units whenever they change:
# reload the manager so the moshi-hook.service drop-in takes effect, and enable
# the pane-rebind timer.
#
# Only the drop-in and the pane-rebind units are managed by chezmoi. The base
# moshi-hook.service is generated by `moshi-hook service install` and must stay
# vendor-owned — run that once per machine after installing Moshi, then chezmoi
# layers the Restart=always drop-in on top.
#
# No-ops where no systemd user manager is reachable (mac, or a `chezmoi apply`
# from cron/ssh with no session bus).
#
# Re-runs when a unit changes:
#   {{ include "dot_config/systemd/user/moshi-hook.service.d/10-restart-always.conf" | sha256sum }}
#   {{ include "dot_config/systemd/user/moshi-pane-rebind.service.tmpl" | sha256sum }}
#   {{ include "dot_config/systemd/user/moshi-pane-rebind.timer" | sha256sum }}
set -eu

command -v systemctl >/dev/null 2>&1 || exit 0
if ! systemctl --user show-environment >/dev/null 2>&1; then
	echo "ensure-moshi-units: no systemd user manager reachable, skipping"
	exit 0
fi

systemctl --user daemon-reload
systemctl --user enable --now moshi-pane-rebind.timer

# A drop-in only reaches the daemon on restart, and the base unit exists only
# once `moshi-hook service install` has run.
if systemctl --user is-active --quiet moshi-hook.service; then
	systemctl --user restart moshi-hook.service
	echo "ensure-moshi-units: units reloaded, moshi-hook restarted to pick up the drop-in"
else
	echo "ensure-moshi-units: units reloaded; moshi-hook.service inactive (run 'moshi-hook service install')"
fi
