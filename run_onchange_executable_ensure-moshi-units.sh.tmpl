#!/bin/sh
# Bring the Moshi hook daemon up on this machine, from nothing if need be:
# install the vendor systemd user service if it is missing, register the
# chezmoi-managed drop-in and pane-rebind timer, and start everything.
#
# Usage: not run by hand. chezmoi runs it during `apply` whenever its rendered
#        content changes (see the hashes below).
#
# The base moshi-hook.service stays VENDOR-owned: it is generated by
# `moshi-hook service install`, which this script now calls itself on a machine
# that has the binary but no unit yet, so a fresh box needs no manual step.
# chezmoi only layers the Restart=always drop-in on top, so the vendor installer
# can rewrite the base unit without discarding it.
#
# Still manual per machine, and not automatable here: installing the moshi-hook
# binary, and `moshi-hook pair --token <token>` (a secret). Without the binary
# this script prints a hint and does nothing.
#
# No-ops where no systemd user manager is reachable — mac, which has no
# `moshi-hook service` support at all, or a `chezmoi apply` from cron/ssh with no
# session bus.
#
# Re-runs when a unit changes:
#   {{ include "dot_config/systemd/user/moshi-hook.service.d/10-restart-always.conf" | sha256sum }}
{{- if eq (.profile | lower) "omarchy" }}
#   {{ include "dot_config/systemd/user/moshi-hook.service.d/20-herdr-path.conf" | sha256sum }}
{{- end }}
#   {{ include "dot_config/systemd/user/moshi-pane-rebind.service.tmpl" | sha256sum }}
#   {{ include "dot_config/systemd/user/moshi-pane-rebind.timer" | sha256sum }}
#   {{ include "dot_config/systemd/user/moshi-reguard.path.tmpl" | sha256sum }}
#   {{ include "dot_config/systemd/user/moshi-reguard.service.tmpl" | sha256sum }}
#   {{ include "dot_codex/modify_hooks.json.tmpl" | sha256sum }}
set -eu

MOSHI_HOOK="{{ .chezmoi.homeDir }}/.local/bin/moshi-hook"
GUARD="{{ .chezmoi.homeDir }}/.local/bin/moshi-hook-claude-guard"
SETTINGS="{{ .chezmoi.homeDir }}/.claude/settings.json"
CODEX_HOOKS="{{ .chezmoi.homeDir }}/.codex/hooks.json"
CODEX_GUARD="{{ .chezmoi.homeDir }}/.local/bin/moshi-codex-hook"
UNIT="{{ .chezmoi.homeDir }}/.config/systemd/user/moshi-hook.service"

command -v systemctl >/dev/null 2>&1 || exit 0
if ! systemctl --user show-environment >/dev/null 2>&1; then
	echo "ensure-moshi-units: no systemd user manager reachable, skipping"
	exit 0
fi

if [ ! -x "$MOSHI_HOOK" ]; then
	echo "ensure-moshi-units: no moshi-hook binary at $MOSHI_HOOK — install it, then 'moshi-hook pair --token <token>'"
	exit 0
fi

installed_now=""
if [ ! -f "$UNIT" ]; then
	echo "ensure-moshi-units: no vendor unit yet, running 'moshi-hook service install'"
	if "$MOSHI_HOOK" service install; then
		installed_now=1
	else
		echo "ensure-moshi-units: 'moshi-hook service install' failed; continuing"
	fi
fi

systemctl --user daemon-reload
systemctl --user enable --now moshi-pane-rebind.timer
systemctl --user enable --now moshi-reguard.path

# A drop-in only reaches the daemon on restart, and the base unit exists only
# once `moshi-hook service install` has succeeded.
if [ -f "$UNIT" ]; then
	systemctl --user enable --now moshi-hook.service
	systemctl --user restart moshi-hook.service
	echo "ensure-moshi-units: units reloaded, moshi-hook running with the drop-in"
else
	echo "ensure-moshi-units: units reloaded; no moshi-hook.service present"
fi

# Without linger a user service dies at logout and never starts at boot, which on a
# headless box means no notifications until someone logs in. Enabling it needs sudo,
# so only warn.
if command -v loginctl >/dev/null 2>&1 &&
	[ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" = "no" ]; then
	echo "ensure-moshi-units: user services stop at logout — run 'loginctl enable-linger $(id -un)' for boot startup"
fi

# The Moshi installer writes Claude's hooks pointing at raw moshi-hook, which
# makes tty-less sessions bind to guessed tmux panes. dot_claude/modify_settings.json
# is the real fix, but it may already have run earlier in this same apply, so
# repair the wiring here too when we just invoked the installer.
if [ -n "$installed_now" ] && [ -f "$SETTINGS" ] && [ -x "$GUARD" ] &&
	command -v python3 >/dev/null 2>&1; then
	python3 - "$SETTINGS" "$GUARD" <<'PY' || echo "ensure-moshi-units: hook-wiring repair skipped"
import json, os, sys
path, guard = sys.argv[1], sys.argv[2]
want = "'" + guard + "' claude-hook"
names = ("moshi-hook", "moshi-hook-claude-guard", "moshi")
try:
    with open(path) as fh:
        settings = json.load(fh)
except Exception:
    sys.exit(0)
changed = 0
for groups in (settings.get("hooks") or {}).values():
    for group in groups if isinstance(groups, list) else []:
        for entry in (group or {}).get("hooks") or []:
            command = entry.get("command") if isinstance(entry, dict) else None
            if not isinstance(command, str) or command == want:
                continue
            if command.split(" ", 1)[0].strip("'\"").rsplit("/", 1)[-1] in names:
                entry["command"] = want
                changed += 1
if changed:
    tmp = path + ".moshi.tmp"
    with open(tmp, "w") as fh:
        json.dump(settings, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)
    print(f"ensure-moshi-units: repointed {changed} Claude hook(s) at the guard wrapper")
PY
fi

# Normalize the Codex hooks immediately after a fresh vendor install. The
# modify_ source does the same during normal applies.
if [ -n "$installed_now" ] && [ -f "$CODEX_HOOKS" ] && [ -x "$CODEX_GUARD" ] &&
	command -v python3 >/dev/null 2>&1; then
	python3 - "$CODEX_HOOKS" "$CODEX_GUARD" <<'PY' || echo "ensure-moshi-units: Codex hook repair skipped"
import json, os, sys
path, moshi_hook = sys.argv[1], sys.argv[2]
command = moshi_hook
names = ("moshi-codex-hook", "moshi-hook", "moshi")
events = ("PermissionRequest", "SessionStart", "Stop", "UserPromptSubmit")
try:
    with open(path) as fh:
        current = json.load(fh)
except Exception:
    sys.exit(0)
hooks = current.setdefault("hooks", {})
for event in events:
    kept = []
    for group in hooks.get(event, []):
        entries = group.get("hooks") if isinstance(group, dict) else None
        if not isinstance(entries, list):
            kept.append(group)
            continue
        remaining = []
        for entry in entries:
            command = entry.get("command") if isinstance(entry, dict) else None
            token = command.split(" ", 1)[0].strip("'\"") if isinstance(command, str) else ""
            if token.rsplit("/", 1)[-1] not in names:
                remaining.append(entry)
        if remaining:
            group = dict(group)
            group["hooks"] = remaining
            kept.append(group)
    kept.append({"hooks": [{"command": command, "type": "command"}]})
    hooks[event] = kept
tmp = path + ".moshi.tmp"
with open(tmp, "w") as fh:
    json.dump(current, fh, indent=2, sort_keys=True)
    fh.write("\n")
os.replace(tmp, path)
print("ensure-moshi-units: normalized Codex hooks")
PY
fi
